# ---------------------------------------------------------------------------
# Template for the repo-root `.env`. Copy it, then edit:
#
#     copy .env.example .env
#
# Loaded by pipeline/scripts/common.py at import time.
# Precedence: real environment variable > .env > built-in default.
# Every key is OPTIONAL — leave a value empty to accept the default.
#
# Paths only. Never put credentials or API keys here: .env is tracked in git.
# ---------------------------------------------------------------------------

# --- Interpreter -----------------------------------------------------------
# Must have numpy, scipy, rasterio (bundled GDAL), scikit-learn, matplotlib.
# There is no `osgeo` binding requirement.
PYTHON_EXE=

# --- Project root ----------------------------------------------------------
# Defaults to the repository root inferred from common.py's own location.
MOON_BASE=
MOON_OUT=
CH2IIRS_REF_DIR=

# --- External GDAL tools ---------------------------------------------------
# Folder holding gdalwarp.exe / gdal_translate.exe. Used by the CH1 TPS warp.
QGIS_BIN=

# --- Chandrayaan-2 IIRS raw scene ------------------------------------------
IIRS_SCENE=
IIRS_DATE=
IIRS_DIR=
# Full overrides, if your layout differs from the PDS4 bundle structure.
IIRS_QUB=
IIRS_XML=
IIRS_SPM=

# --- Chandrayaan-1 M3 raw scene --------------------------------------------
M3_SCENE=
M3_DIR=
M3_RFL=
M3_LOC=
