# ---------------------------------------------------------------------------
# Machine-specific configuration for the Moon soil mineral mapping pipeline.
#
# Loaded by pipeline/scripts/common.py at import time.
# Precedence: real environment variable > this file > built-in default.
# Every key is OPTIONAL — delete a line to fall back to the default.
#
# Contains paths only. Never put credentials or API keys in this file:
# it is tracked in git.
# ---------------------------------------------------------------------------

# --- Interpreter -----------------------------------------------------------
# Must have numpy, scipy, rasterio (bundled GDAL), scikit-learn, matplotlib.
# Read by humans and the runbook, not by the scripts themselves.
PYTHON_EXE=C:\Users\HP\anaconda3\python.exe

# --- Project root ----------------------------------------------------------
# Defaults to the repository root inferred from common.py's own location,
# so this normally needs no value at all.
MOON_BASE=

# Derived from MOON_BASE unless set explicitly.
MOON_OUT=
CH2IIRS_REF_DIR=

# --- External GDAL tools ---------------------------------------------------
# gdalwarp.exe / gdal_translate.exe live here. Used by the CH1 TPS warp.
QGIS_BIN=C:\Program Files\QGIS 3.40.12\bin

# --- Chandrayaan-2 IIRS raw scene ------------------------------------------
IIRS_SCENE=ch2_iir_nri_20250804T0253259678_d_img_d18
IIRS_DATE=20250804
# Directory holding data/raw/<IIRS_DATE>/ and miscellaneous/calibrated/<IIRS_DATE>/.
# Defaults to <MOON_BASE>/ch2/ch2/ch2/<IIRS_SCENE>.
IIRS_DIR=

# Full overrides, if your layout differs from the PDS4 bundle structure.
IIRS_QUB=
IIRS_XML=
IIRS_SPM=

# --- Chandrayaan-1 M3 raw scene --------------------------------------------
M3_SCENE=m3g20090731t045352
M3_DIR=
M3_RFL=
M3_LOC=
